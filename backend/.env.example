PORT=5000

# MySQL 8 (go-sql-driver DSN). The database is created and migrated automatically on start.
MYSQL_DSN=root:YOUR_PASSWORD@tcp(127.0.0.1:3306)/bus_transit_db?parseTime=true

# Long random string used to sign login tokens
JWT_SECRET=change_me_to_a_long_random_secret

# Load demo routes/buses/accounts into an EMPTY database (see backend/README.md). Set false in production.
SEED_DEMO_DATA=true

# URL that phones and PayHere use to reach this server (use your PC's LAN IP for a real phone)
PUBLIC_BASE_URL=http://localhost:5000

# Firebase (Realtime DB mirror + FCM push). Put the service-account JSON next to this file.
FIREBASE_CREDENTIALS_FILE=firebase-service-account.json
# e.g. https://your-project-default-rtdb.asia-southeast1.firebasedatabase.app
FIREBASE_DATABASE_URL=

# PayHere merchant (leave empty for the simulated payment demo mode)
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_SANDBOX=true
